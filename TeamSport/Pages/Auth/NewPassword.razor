@page "/new-password"
@page "/new-password/{TokenFromQuery}"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject NavigationManager NavManager

@using System.Web
@using Microsoft.AspNetCore.Components.Routing
@using System.ComponentModel.DataAnnotations

<div class="reset-password-container">
    <div class="left-side">
        <!-- Ảnh nền hoặc trang trí -->
    </div>

    <div class="right-side">
        <div class="form-title">Đặt mật khẩu mới</div>
        <div class="form-subtitle">
            Mật khẩu trước đó của bạn đã được đặt lại. Vui lòng đặt mật khẩu mới cho tài khoản của bạn.
        </div>

        <EditForm Model="@passwordModel" OnValidSubmit="HandlePasswordSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <InputText class="single-input" type="password" placeholder="Mật khẩu mới" @bind-Value="passwordModel.NewPassword" />
            <ValidationMessage For="@(() => passwordModel.NewPassword)" />

            <InputText class="single-input" type="password" placeholder="Nhập lại mật khẩu mới" @bind-Value="passwordModel.ConfirmPassword" />
            <ValidationMessage For="@(() => passwordModel.ConfirmPassword)" />

            <button type="submit" class="btn-register" disabled="@IsLoading">
                @(IsLoading ? "Đang xử lý..." : "Đặt mật khẩu mới")
            </button>
        </EditForm>


        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p style="color:red;">@ErrorMessage</p>
        }
    </div>
</div>

@code {
    private PasswordModel passwordModel = new();
    private bool IsLoading = false;
    private string ErrorMessage;

    [Parameter]
    [SupplyParameterFromQuery(Name = "token")]
    public string? TokenFromQuery { get; set; }

    protected override void OnInitialized()
    {
        
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = HttpUtility.ParseQueryString(uri.Query);
        var token = query.Get("token");

        if (!string.IsNullOrEmpty(token))
        {
            passwordModel.Token = token;
        }
    }

    private async Task HandlePasswordSubmit()
    {
        ErrorMessage = null;

        if (passwordModel.NewPassword != passwordModel.ConfirmPassword)
        {
            ErrorMessage = "Mật khẩu không khớp.";
            return;
        }

        if (string.IsNullOrEmpty(passwordModel.Token))
        {
            ErrorMessage = "Token không hợp lệ hoặc đã hết hạn.";
            return;
        }

        IsLoading = true;

        try
        {
            var requestData = new
            {
                newPassword = passwordModel.NewPassword,
                token = passwordModel.Token
            };

            var response = await Http.PostAsJsonAsync("https://localhost:7000//api/auth/reset-password", requestData);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

                if (!string.IsNullOrEmpty(result?.Token))
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", "jwtToken", result.Token);
                    Navigation.NavigateTo("/");
                }
                else
                {
                    ErrorMessage = "Token không hợp lệ từ server.";
                }
            }
            else
            {
                ErrorMessage = "Đặt mật khẩu mới thất bại. Vui lòng thử lại.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi kết nối: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    public class PasswordModel
    {
        [Required(ErrorMessage = "Vui lòng nhập mật khẩu mới")]
        [MinLength(6, ErrorMessage = "Mật khẩu phải có ít nhất 6 ký tự")]
        [RegularExpression(@"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&._\-])[A-Za-z\d@$!%*?&._\-]{6,}$",
        ErrorMessage = "Mật khẩu phải chứa chữ hoa, chữ thường, số và ký tự đặc biệt")]
        public string NewPassword { get; set; } = "";
        [Required(ErrorMessage = "Vui lòng nhập lại mật khẩu")]
        [Compare("NewPassword", ErrorMessage = "Mật khẩu không khớp")]
        public string ConfirmPassword { get; set; } = "";
        public string Token { get; set; } = "";
    }

    public class LoginResponse
    {
        public string Token { get; set; }
    }
}


